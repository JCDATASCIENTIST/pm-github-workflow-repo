# PM GitHub Workflow .gitignore

# SECRETS
.env
.env.*
*.key
*.pem
api-keys.md
secrets/

# OS FILES
.DS_Store
Thumbs.db
*.swp
*~

# NODE / NPM
node_modules/
package-lock.json
yarn.lock
bun.lockb

# PYTHON
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# LARGE DATA FILES
*.csv
*.xlsx
*.xls
data/raw/
exports/
recordings/
transcripts/raw/
*.mp3
*.mp4
*.wav
*.m4a
*.mov
*.zip
*.tar.gz

# CLAUDE CODE
.claude/settings.local.json
.claude/statsig/
# Activated skill copies. The source of truth is skills/; .claude/skills/ is a
# local convenience copy (see README), so it shouldn't be committed twice.
.claude/skills/

# IDE FILES
.vscode/
.cursor/
.idea/
*.code-workspace

# BUILD ARTIFACTS
dist/
build/
out/
*.log
.next/
.vercel/

# PM-SPECIFIC
*.otter
*.granola
drafts/wip/
scratch/
screenshots/
screen-recordings/

# RESEARCH OUTPUTS (often contain customer PII / verbatim quotes)
# The skills here save dated files like feedback-synthesis-2026-06-01.md and
# competitor-acme-2026-06-01.md. Patterns are anchored to the DATED form so they
# only catch generated outputs, never the repo's own source (skills/, evals/).
# Ignored by default so a transcript full of customer names can't be committed
# by accident. Want to share a sanitized one? `git add -f <file>`
feedback-synthesis-20[0-9][0-9]-*.md
competitor-*-20[0-9][0-9]-*.md
transcripts/
interviews/
data/exports/
# Belt-and-suspenders: never ignore the repo's own versioned source folders.
!skills/**
!evals/**

# ENTERPRISE NOTE
# Add regulated document types here
# Consider CODEOWNERS for review requirements
# NDA materials should NEVER be in any repo
